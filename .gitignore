# GenzTeck monorepo
# Covers: client/ (public site), admin/ (dashboard), server/ (API)

# Dependencies
node_modules/
**/node_modules/

# Production builds
dist/
**/dist/
build/
**/build/

# Vite / frontend caches
.vite/
**/.vite/
.cache/
**/.cache/
.parcel-cache/
**/.parcel-cache/

# Environment files
.env
.env.*
**/.env
**/.env.*

# Keep safe examples tracked
!.env.example
!**/.env.example

# Server uploads and runtime files
server/uploads/*
!server/uploads/.gitkeep
uploads/
tmp/
temp/

# Logs
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Test coverage
coverage/
**/coverage/
.nyc_output/
**/.nyc_output/

# Package manager caches
.npm/
.pnpm-store/
.yarn/
!.yarn/releases/
!.yarn/plugins/
!.yarn/sdks/
!.yarn/versions/
.pnp.*
.yarn-integrity

# TypeScript / tooling cache
*.tsbuildinfo
.eslintcache
**/.eslintcache

# OS files
.DS_Store
**/.DS_Store
Thumbs.db
**/Thumbs.db
Desktop.ini

# Editor / IDE
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp

# Local secrets / certificates
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
